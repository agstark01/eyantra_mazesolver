// Task 2C - MazeSolver Bot

module t2c_maze_explorer (
    input clk,
    input rst_n,
    input left, mid, right, // 0 - no wall, 1 - wall
    output reg [2:0] move
);

/*

| cmd | move  | meaning   |
|-----|-------|-----------|
| 000 | 0     | STOP      |
| 001 | 1     | FORWARD   |
| 010 | 2     | LEFT      |
| 011 | 3     | RIGHT     | 
| 100 | 4     | U_TURN    |

START POS   : 4,0
EXIT POS    : 4,8
DEADENDS    : 9

*/
//////////////////DO NOT MAKE ANY CHANGES ABOVE THIS LINE //////////////////

parameter N = 2'b00,E = 2'b01,W = 2'b10,S = 2'b11;

reg visited[8:0][8:0];
reg visitedret[8:0][8:0];
reg [3:0] pos_x = 0, pos_y = 0;
reg [1:0] direc = 0;
reg [1:0] stack [25:0];
reg [1:0] stackret [25:0];
reg [4:0] ptrret = 0;
reg [4:0] ptr = 0;
//integer i,j,k;
reg [2:0]choose = 0;
reg add_x, add_y, as;
reg clk2 = 0;
//always@(posedge clk,negedge rst_n)begin
//	if(!rst_n) clk2 <= 0;
//    else clk2 <= ~clk2;
//end

integer i,j,k;
initial begin
	for (i = 0; i < 9; i = i + 1'b1)begin
            for(j = 0 ; j < 9; j = j + 1'b1)begin
                visited[i][j] = 0;
					 visitedret[i][j] = 0;
            end
        end
	for(k = 0; k < 26; k = k + 1)begin
		stack[k] = 0;
		stackret[k] = 0;
	end
end

reg all_visited;
reg [2:0] debugg = 0;

always @(*) begin
    all_visited = 1'b1;  // assume all are 1
    for (i = 0; i < 9; i = i + 1)
        for (j = 0; j < 9; j = j + 1)
            if (!visited[i][j])
                all_visited = 1'b0;
end

reg ready ;
//assign ready = ((pos_x == 4)&(pos_y == 8));
always@(posedge clk)begin
	if(!rst_n)begin
		ready <= 0;
	end else if((pos_x == 4)&(pos_y == 8)) begin
		ready <= 1; 
	end 
    // else if (all_visited & (pos_x == 4)&(pos_y == 8)) begin
	// 	ready <= 0;
	// end
end

always @(posedge clk, negedge rst_n) begin
    if(!rst_n)begin
		  ptr <= 0;
        pos_x <= 4;
        pos_y <= 0;
        ptr <= 0;
		  ptrret <= 0;
		  move <= 3'b000;
		  direc <= N;
		  debugg <= 0;
		  clk2 <= 1;
    end else begin
		  if(clk2)begin
        if(((!left & right & mid) | (left & !right & mid) |(left & right & !mid))&&(((pos_x != 4)||(pos_y != 8))&& !all_visited))begin
            // update move
				//debugg <= 1;
            move <= {1'b0,mid,((!mid)|(left)|(!right))};
            // stack[ptr] <= move[1:0];
            visited[pos_x][pos_y] <= 1;
				visitedret[pos_x][pos_y] <= ready;
            // update directions
            case(direc)
					N: begin 
							direc <= mid?(left?E:W):N;
							pos_x <= pos_x + !right - !left;
							pos_y <= pos_y + !mid;
						end
					E: begin 
							direc <= mid?(left?S:N):E;
							pos_x <= pos_x + !mid;
							pos_y <= pos_y + !left - !right;
						end
					W: begin 
							direc <= mid?(left?N:S):W;
							pos_x <= pos_x - !mid;
							pos_y <= pos_y - !left + !right;
						end
					S: begin 
							direc <= mid?(left?W:E):S;
							pos_x <= pos_x - !right + !left;
							pos_y <= pos_y - !mid;
						end
					endcase
        end
        else if(((!(left & right & mid))&(!all_visited))&&((pos_x != 4)||(pos_y != 8)))begin
        visited[pos_x][pos_y] <= 1;
		  visitedret[pos_x][pos_y] <= ready;
		  debugg <= 2;
        case(direc)
					N: begin 
							if(!left & !visited[pos_x-1'b1][pos_y])begin
                                move <= 3'b010; // take left
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= W;
                                pos_x <= pos_x - 1'b1;
                                pos_y <= pos_y;
                            end else if(!right & !visited[pos_x + 1'b1][pos_y])begin
                                move <= 3'b011; // take right
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										 if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= E;
                                pos_x <= pos_x + 1'b1;
                                pos_y <= pos_y;
                            end else if(!mid & !visited[pos_x][pos_y + 1'b1])begin
                                move <= 3'b001; // go forward
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										  if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= N;
                                pos_x <= pos_x;
                                pos_y <= pos_y + 1'b1;
                            end else begin
                                move <= choose;
                                direc <= stack[ptr- 1'b1];
                                ptr <= ptr - 1'b1;
//										  ptrret <= ptrret - 1'b1;										  
                                pos_x <= (as)?(pos_x - add_x):(pos_x + add_x);
                                pos_y <= (as)?(pos_y - add_y):(pos_y + add_y);
                            end
									 if(ready)begin
										if(!visitedret[pos_x][pos_y])begin
												stackret[ptrret] <= ~direc;
												ptrret <= ptrret + 1'b1;
										end else if(!((!left & !visitedret[pos_x-1'b1][pos_y])|(!right & !visitedret[pos_x + 1'b1][pos_y])|(!mid & !visitedret[pos_x][pos_y + 1'b1]))) begin
											   ptrret <= ptrret - 1'b1;
										end
									 end
						end
					E: begin 
							if((pos_x == 3)&(pos_y == 2))begin
								if(!left & !visited[pos_x][pos_y + 1'b1])begin
                                move <= 3'b010; // take left
										  if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//                                if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= N;
                                pos_x <= pos_x;
                                pos_y <= pos_y + 1'b1;
                            end 
										 else if(!mid & !visited[pos_x + 1'b1][pos_y])begin
                                move <= 3'b001; // go forward
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= E;                                
                                pos_x <= pos_x + 1'b1;
                                pos_y <= pos_y ;
                            end else if(!right & !visited[pos_x][pos_y - 1'b1])begin
                                move <= 3'b011; // take right
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//											if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= S;
                                pos_x <= pos_x;
                                pos_y <= pos_y - 1'b1;
                            end else begin
                                move <= choose;
                                direc <= stack[ptr - 1'b1];
                                ptr <= ptr - 1'b1;
//										  ptrret <= ptrret - 1'b1;
                                pos_x <= (as)?(pos_x - add_x):(pos_x + add_x);
                                pos_y <= (as)?(pos_y - add_y):(pos_y + add_y);
                            end
							  end
									 else begin
										if(!right & !visited[pos_x][pos_y - 1'b1])begin
                                move <= 3'b011; // take right
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//											if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= S;
                                pos_x <= pos_x;
                                pos_y <= pos_y - 1'b1;
                            end else if(!mid & !visited[pos_x + 1'b1][pos_y])begin
                                move <= 3'b001; // go forward
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= E;                                
                                pos_x <= pos_x + 1'b1;
                                pos_y <= pos_y ;
                            end else if(!left & !visited[pos_x][pos_y + 1'b1])begin
                                move <= 3'b010; // take left
										  if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//                                if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= N;
                                pos_x <= pos_x;
                                pos_y <= pos_y + 1'b1;
                            end else begin
                                move <= choose;
                                direc <= stack[ptr - 1'b1];
                                ptr <= ptr - 1'b1;
//										  ptrret <= ptrret - 1'b1;
                                pos_x <= (as)?(pos_x - add_x):(pos_x + add_x);
                                pos_y <= (as)?(pos_y - add_y):(pos_y + add_y);
                            end
									 
								end 
									 if(ready)begin
										if(!visitedret[pos_x][pos_y])begin
												stackret[ptrret] <= ~direc;
												ptrret <= ptrret + 1'b1;
										end else if(!((!right & !visitedret[pos_x][pos_y - 1'b1])|(!mid & !visitedret[pos_x + 1'b1][pos_y])|(!left & !visitedret[pos_x][pos_y + 1'b1]))) begin
											   ptrret <= ptrret - 1'b1;
										end
									 end
						end
					W: begin 
							if(!left & !visited[pos_x][pos_y - 1'b1])begin
                                move <= 3'b010; // take left
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										 if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= S;
                                pos_x <= pos_x;
                                pos_y <= pos_y - 1'b1;
                            end else if(!mid & !visited[pos_x - 1'b1][pos_y])begin
                                move <= 3'b001; // go forward
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= W;                                
                                pos_x <= pos_x - 1'b1;
                                pos_y <= pos_y;
                            end else if(!right & !visited[pos_x][pos_y + 1'b1])begin
                                move <= 3'b011; // take right
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//											if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
										
                                direc <= N;
                                pos_x <= pos_x;
                                pos_y <= pos_y + 1'b1;
                            end else begin
                                move <= choose;
                                direc <= stack[ptr- 1'b1];
//										  ptrret <= ptrret - 1'b1;
                                ptr <= ptr - 1'b1;
                                pos_x <= (as)?(pos_x - add_x):(pos_x + add_x);
                                pos_y <= (as)?(pos_y - add_y):(pos_y + add_y);
                            end
									 if(ready)begin
										if(!visitedret[pos_x][pos_y])begin
												stackret[ptrret] <= ~direc;
												ptrret <= ptrret + 1'b1;
										end else if(!((!left & !visitedret[pos_x][pos_y - 1'b1])|(!mid & !visitedret[pos_x - 1'b1][pos_y])|(!right & !visitedret[pos_x][pos_y + 1'b1]))) begin
											   ptrret <= ptrret - 1'b1;
										end
									 end
						end
					S: begin 
                            if(!mid & !visited[pos_x][pos_y - 1'b1])begin
                                move <= 3'b001; // go forward
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= S;
                                pos_x <= pos_x;
                                pos_y <= pos_y - 1'b1;
                            end else if(!left & !visited[pos_x + 1'b1][pos_y])begin
                                move <= 3'b010; // take left
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//									if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= E;
                                pos_x <= pos_x + 1'b1;
                                pos_y <= pos_y;
                            end else if(!right & !visited[pos_x - 1'b1][pos_y])begin
                                move <= 3'b011; // take right
                                if(!visited[pos_x][pos_y])begin                                    
                                    stack[ptr] <= ~direc;
                                    ptr <= ptr + 1'b1;
                                end
//										if( ready & !visitedret[pos_x][pos_y])begin
//												stackret[ptrret] <= ~direc;
//												ptrret <= ptrret + 1'b1;
//											end
                                direc <= W;
                                pos_x <= pos_x - 1'b1;
                                pos_y <= pos_y;
                            end else begin
                                move <= choose;
                                direc <= stack[ptr- 1'b1];
                                ptr <= ptr - 1'b1;
//										  ptrret <= ptrret - 1'b1;
                                pos_x <= (as)?(pos_x - add_x):(pos_x + add_x);
                                pos_y <= (as)?(pos_y - add_y):(pos_y + add_y);
                            end
									 if(ready)begin
										if(!visitedret[pos_x][pos_y])begin
												stackret[ptrret] <= ~direc;
												ptrret <= ptrret + 1'b1;
										end else if(!((!mid & !visitedret[pos_x][pos_y - 1'b1])|(!left & !visitedret[pos_x + 1'b1][pos_y])|(!right & !visitedret[pos_x - 1'b1][pos_y]))) begin
											   ptrret <= ptrret - 1'b1;
										end
									 end
						end
					endcase
        end else if((left & right & mid)|(((pos_x == 4)&&(pos_y == 8))&&(!all_visited))) begin
                move <= 3'b100;
					 visited[pos_x][pos_y] <= 1;
					 visitedret[pos_x][pos_y] <= ready;
					 debugg <= 3;
                 case(direc)
					N: begin 
							direc <= S;
                     pos_x <= pos_x;
							pos_y <= pos_y - 1'b1;
						end
					E: begin 
							direc <= W;
                     pos_x <= pos_x - 1'b1;
							pos_y <= pos_y;
						end
					W: begin 
							direc <= E;
                     pos_x <= pos_x + 1'b1;
							pos_y <= pos_y;
						end
					S: begin 
							direc <= N;
                     pos_x <= pos_x;
							pos_y <= pos_y + 1'b1;
						end
					endcase
					end else if(all_visited) begin
					debugg <= 4;
				if((pos_x == 4)&(pos_y == 8))begin
					case(direc)
						N: move <= 3'b001;
						E: move <= 3'b010;
						W: move <= 3'b011;
						S: move <= 3'b100;
					endcase
					ptr <= 0;
					ptrret <= 0;
					direc <= N;
					pos_x <= 4;
					pos_y <= 0;
					for (i = 0; i < 9; i = i + 1'b1)begin
						for(j = 0 ; j < 9; j = j + 1'b1)begin
						visited[i][j] <= 0;
						visitedret[i][j] <= 0;
						end
					end
				end else begin
					move <= choose;
					direc <= stackret[ptrret- 1'b1];
					ptrret <= ptrret - 1'b1;
					pos_x <= (as)?(pos_x - add_x):(pos_x + add_x);
					pos_y <= (as)?(pos_y - add_y):(pos_y + add_y);
				end
		  end
//					else begin
//						//debugg <= 5;
//						move <= 3'b000;
//						direc <= N;
//						pos_x <= 4;
//						pos_y <= 0;
//						ptr <= 0;
//						ptrret <= 0;
//						for (i = 0; i < 9; i = i + 1'b1)begin
//						for(j = 0 ; j < 9; j = j + 1'b1)begin
//						visited[i][j] <= 0;
//						visitedret[i][j] <= 0;
//						end
//					end
//					end
						clk2 <= clk2 + 1'b1;
			end 
       else begin
		 //move <= 3'b000;
		clk2 <= clk2 + 1'b1;
	 end
	 end
	 
end

// calculate direction based on stack ** combinational logic **
// N = 00, E = 01, W = 10, S = 11,
wire [1:0]top;
assign top = (all_visited)?stackret[ptrret - 1'b1]:stack[ptr - 1'b1];

always@(*) begin
    case(direc)
    N:begin
        case(top)
            N:begin
                choose = 3'b001;
                add_x = 0;
                add_y = 1;
                as = 0;
            end
            E:begin
                choose = 3'b011;
                add_x = 1;
                add_y = 0;
                as = 0;
            end
            W:begin
                choose = 3'b010;
                add_x = 1;
                add_y = 0;
                as = 1;
            end
            S:begin
                choose = 3'b100;
                add_x = 0;
                add_y = 1;
                as = 1;
            end
        endcase
    end
    E:begin
        case(top)
            N:begin
                choose = 3'b010;
                add_x = 0;
                add_y = 1;
                as = 0;
            end
            E:begin
                choose = 3'b001;
                add_x = 1;
                add_y = 0;
                as = 0;
            end
            W:begin
                choose = 3'b100;
                add_x = 1;
                add_y = 0;
                as = 1;
            end
            S:begin
                choose = 3'b011;
                add_x = 0;
                add_y = 1;
                as = 1;
            end
        endcase
    end
    W:begin
        case(top)
            N:begin
                choose = 3'b011;
                add_x = 0;
                add_y = 1;
                as = 0;
            end
            E:begin
                choose = 3'b100;
                add_x = 1;
                add_y = 0;
                as = 0;
            end
            W:begin
                choose = 3'b001;
                add_x = 1;
                add_y = 0;
                as = 1;
            end
            S:begin
                choose = 3'b010;
                add_x = 0;
                add_y = 1;
                as = 1;
            end
        endcase
    end
    S:begin
        case(top)
            N:begin
                choose = 3'b100;
                add_x = 0;
                add_y = 1;
                as = 0;
            end
            E:begin
                choose = 3'b010;
                add_x = 1;
                add_y = 0;
                as = 0;
            end
            W:begin
                choose = 3'b011;
                add_x = 1;
                add_y = 0;
                as = 1;
            end
            S:begin
                choose = 3'b001;
                add_x = 0;
                add_y = 1;
                as = 1;
            end
        endcase
    end
    endcase
end

//////////////////DO NOT MAKE ANY CHANGES BELOW THIS LINE //////////////////

endmodule
